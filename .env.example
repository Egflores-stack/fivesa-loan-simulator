# Guia de variables de entorno - CREDIA Loan Simulator
# Ver backend/.env.example y frontend/.env.example para los archivos por servicio.

## Backend (backend/.env)
PGHOST=localhost
PGPORT=5432
PGDATABASE=credia_db
PGUSER=postgres
PGPASSWORD=CAMBIAR_PASSWORD_DB

PORT=3000
NODE_ENV=development

JWT_SECRET=CAMBIAR_POR_SECRETO_LARGO_ALEATORIO
JWT_EXPIRES_IN=24h

FRONTEND_URL=http://localhost:5173
# FRONTEND_DIST_PATH=../frontend/dist

DEMO_MODE_ENABLED=false
DEMO_MODE_EXPIRES_AT=2026-12-31T23:59:59-06:00
# Super admin: debe coincidir con ADMIN_INITIAL_USERNAME para gestionar parametrizacion
SUPER_ADMIN_USERNAME=admin

ADMIN_INITIAL_EMAIL=admin@credia.local
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CAMBIAR_CLAVE_ADMIN

## Frontend (frontend/.env)
VITE_API_URL=/api
