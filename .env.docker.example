# ==============================================================================
# Variables de entorno para despliegue Docker de CREDIA Loan Simulator
# ==============================================================================
# Uso:
#   cp .env.docker.example .env.docker
#   Editar .env.docker con valores reales antes de levantar Docker Compose.
#
# Como generar secretos fuertes en Linux/macOS:
#   openssl rand -hex 32
# ==============================================================================

# --- Aislamiento de instancia y puerto en localhost del VPS ---
# Cambia COMPOSE_PROJECT_NAME y APP_PORT si despliegas una segunda instancia
# en el mismo VPS (aísla contenedores, volumen de BD y red Docker).
COMPOSE_PROJECT_NAME=credia
APP_PORT=3100

# --- Entorno de Node ---
NODE_ENV=production

# --- Base de datos PostgreSQL (servicio db) ---
PGDATABASE=credia_db
PGUSER=credia_user
# OBLIGATORIA: generar con `openssl rand -hex 24`
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_DB_SEGURA

# --- Seguridad JWT ---
# OBLIGATORIA: generar con `openssl rand -hex 32`
JWT_SECRET=CAMBIAR_POR_SECRETO_JWT_LARGO_ALEATORIO
JWT_EXPIRES_IN=24h

# --- CORS / URL publica final ---
# Debe coincidir exactamente con el origen publico desde donde acceden los usuarios
# Ejemplo: https://credia.tudominio.com
FRONTEND_URL=https://CAMBIAR_DOMINIO_CREDIA

# --- Usuario administrador inicial (setupDatabase.js) ---
# SUPER_ADMIN_USERNAME debe coincidir con ADMIN_INITIAL_USERNAME
SUPER_ADMIN_USERNAME=admin
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_EMAIL=admin@credia.local
# OBLIGATORIA: clave inicial segura para el primer ingreso
ADMIN_INITIAL_PASSWORD=CAMBIAR_CLAVE_ADMIN_SEGURA

# --- Modo demo global (opcional) ---
DEMO_MODE_ENABLED=false
DEMO_MODE_EXPIRES_AT=2026-12-31T23:59:59-06:00

# --- Variables de compilacion del Frontend (se fijan en `docker compose build`) ---
VITE_API_URL=/api
VITE_CONTACT_EMAIL=
