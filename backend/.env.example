# Variables de entorno para CREDIA Loan Simulator (Backend)
# Copiar este archivo como .env y configurar los valores reales

# Base de datos PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=credia_db
PGUSER=postgres
PGPASSWORD=CAMBIAR_PASSWORD_DB

# Servidor
PORT=3000
NODE_ENV=development

# JWT (obligatorio en produccion/arranque)
JWT_SECRET=CAMBIAR_POR_SECRETO_LARGO_ALEATORIO
JWT_EXPIRES_IN=24h

# CORS (origen permitido del frontend en desarrollo o despliegue separado)
FRONTEND_URL=http://localhost:5173

# Ruta opcional al build del frontend (por defecto ../frontend/dist)
# FRONTEND_DIST_PATH=../frontend/dist

# Demo global (opcional)
DEMO_MODE_ENABLED=false
DEMO_MODE_EXPIRES_AT=2026-12-31T23:59:59-06:00
# Super admin (debe coincidir con ADMIN_INITIAL_USERNAME para gestionar parametrizacion)
SUPER_ADMIN_USERNAME=admin

# Usuario administrador inicial para setup de BD (solo para script de inicializacion)
ADMIN_INITIAL_EMAIL=admin@credia.local
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CAMBIAR_CLAVE_ADMIN
